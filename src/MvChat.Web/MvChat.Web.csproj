<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MvChat.Web</RootNamespace>
    <AssemblyName>MvChat.Web</AssemblyName>
    <Version>0.1.0</Version>
    <!-- Aruba Windows hosting: IIS in-process (ASP.NET Core Module V2), framework-dependent: sul server ci sono .NET 9 e 10 -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <!--
    OfflineBuild=true compila senza scaricare pacchetti NuGet (solo per controlli
    rapidi in ambienti senza rete). La build vera (GitHub Actions) include MySqlConnector.
  -->
  <PropertyGroup Condition="'$(OfflineBuild)' != 'true'">
    <DefineConstants>$(DefineConstants);HAS_MYSQL</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(OfflineBuild)' != 'true'">
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Schema\*.sql" />
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
