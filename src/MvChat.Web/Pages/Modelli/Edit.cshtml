@page "{id:int?}"
@model MvChat.Web.Pages.Modelli.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Nuovo modello di obiettivo" : "Modifica modello"; }
<form method="post" class="panel">
    <input type="hidden" asp-for="Input.Id">
    <div class="panel-b form">
        @if (Model.IsNew && Model.Me.IsSuperAdmin)
        {
            <div class="field full"><label asp-for="Input.OrganizationId">Vale per</label>
                <select asp-for="Input.OrganizationId" asp-items="@(new SelectList(Model.Orgs, "Id", "Name"))"><option value="">Tutti i gruppi (standard MVitalia)</option></select>
                <span asp-validation-for="Input.OrganizationId" class="field-error"></span></div>
        }
        <div class="field"><label asp-for="Input.Name">Nome</label><input asp-for="Input.Name" placeholder="es. Rinnovo con prova corso"><span asp-validation-for="Input.Name" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.MaxAiMessages">Messaggi massimi dell'assistente</label><input asp-for="Input.MaxAiMessages" type="number" min="2" max="15"><span asp-validation-for="Input.MaxAiMessages" class="field-error"></span></div>
        <div class="field full"><label asp-for="Input.Success">La conversazione è riuscita quando…</label><input asp-for="Input.Success" placeholder="es. il cliente prenota una lezione di prova"><span asp-validation-for="Input.Success" class="field-error"></span></div>
        <div class="field full"><label asp-for="Input.Instructions">Come deve muoversi l'assistente</label><textarea asp-for="Input.Instructions" rows="7"></textarea><small>Scrivi come lo spiegheresti a un nuovo collega della reception. Le regole di base (presentarsi, non inventare, STOP, passaggio a una persona) le aggiunge mvchat da solo.</small><span asp-validation-for="Input.Instructions" class="field-error"></span></div>
        <div class="field full"><label asp-for="Input.TemplateSuggestion">Testo suggerito per il primo messaggio</label><textarea asp-for="Input.TemplateSuggestion" rows="3"></textarea><small>Segnaposto: {{nome}}, {{cognome}}, {{abbonamento}}, {{scadenza}}, {{sede}}, {{offerta}}, {{servizio}}, {{note}}. Il testo definitivo va approvato da Meta.</small></div>
        <div class="field"><label class="check"><input asp-for="Input.NeedsOffer"> Serve un'offerta collegata</label></div>
        <div class="field"><label class="check"><input asp-for="Input.IsActive"> Modello attivo</label></div>
    </div>
    <div class="actions"><a class="btn" href="/Modelli">Annulla</a><button class="btn primary" type="submit">Salva</button></div>
</form>
