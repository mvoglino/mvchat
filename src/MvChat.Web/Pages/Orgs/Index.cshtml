@page
@model MvChat.Web.Pages.Orgs.IndexModel
@{ ViewData["Title"] = "Catene"; }
@section Actions { <a class="btn primary" href="/Orgs/Edit">Nuova catena</a> }
<p class="muted" style="margin:0">Ogni catena è un cliente di mvchat: ha il suo logo, il suo colore, le sue palestre e i suoi utenti, separati da tutti gli altri.</p>
<section class="panel"><div class="tbl"><table>
    <thead><tr><th>Catena</th><th>Colore</th><th>Palestre</th><th>Utenti</th><th>Stato</th><th></th></tr></thead>
    <tbody>
    @foreach (var o in Model.Items)
    {
        <tr><td><b>@o.Name</b><div class="muted">@o.Slug</div></td>
            <td><span class="swatch" style="background:@o.PrimaryColor"></span> <code>@o.PrimaryColor</code></td>
            <td>@o.Gyms</td><td>@o.Users</td>
            <td>@(o.IsActive ? Html.Raw("<span class=\"chip good\">Attiva</span>") : Html.Raw("<span class=\"chip bad\">Sospesa</span>"))</td>
            <td><a class="btn sm" href="/Orgs/Edit/@o.Id">Modifica</a></td></tr>
    }
    @if (Model.Items.Count == 0) { <tr><td colspan="6" class="muted">Nessuna catena. Crea la prima, ad esempio FitActive.</td></tr> }
    </tbody>
</table></div></section>
