@page "{id:int?}"
@model MvChat.Web.Pages.Gyms.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Nuova attività" : "Modifica attività"; }
@section Actions { @if (!Model.IsNew) { <a class="btn" href="/Attivita/@Model.Input.Id">Dati e logo</a> } }
<form method="post" class="panel">
    <input type="hidden" asp-for="Input.Id">
    <div class="panel-b form">
        @if (Model.Me.IsSuperAdmin && Model.IsNew)
        {
            <div class="field full"><label for="org">Fa parte di un gruppo?</label>
                <select id="org" name="Input.OrganizationId">
                    <option value="">No: attività singola</option>
                    @foreach (var g in Model.Groups) { <option value="@g.Id" selected="@(g.Id == Model.Input.OrganizationId)">Sì, del gruppo @g.Name</option> }
                </select>
                <small>Attività singola: ha il suo amministratore e i suoi operatori. In un gruppo: c'è anche l'amministratore del gruppo, che vede tutte le sue attività.</small>
                <span asp-validation-for="Input.OrganizationId" class="field-error"></span></div>
            <div class="field" id="sectorField"><label asp-for="Input.Sector">Tipo di attività</label><select asp-for="Input.Sector">@foreach (var s in Sectors.All) { <option value="@s.Key">@s.Label</option> }</select><small>Per le attività di un gruppo vale quello del gruppo (si può cambiare da «Dati e logo»).</small><span asp-validation-for="Input.Sector" class="field-error"></span></div>
        }
        else if (Model.Existing is not null)
        {
            <div class="field full"><label>Gruppo</label><div>@(Model.Existing.InGroup ? Model.Existing.OrganizationName : "— attività singola —")</div></div>
        }
        <div class="field"><label asp-for="Input.Name">Nome attività</label><input asp-for="Input.Name" placeholder="es. FitActive Alba, Hotel Langhe"><span asp-validation-for="Input.Name" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.City">Città</label><input asp-for="Input.City"></div>
        <div class="field"><label asp-for="Input.Address">Indirizzo</label><input asp-for="Input.Address"></div>
        <div class="field"><label asp-for="Input.Phone">Telefono</label><input asp-for="Input.Phone" type="tel"></div>
        @if (Model.Me.IsSuperAdmin)
        {
            <div class="field full" style="border-top:1px solid var(--line);padding-top:12px"><b>Abbonamento a mvchat</b> <small>Il consumo AI si aggiunge a parte, con il ricarico delle impostazioni di fatturazione. I messaggi WhatsApp li paga l'attività direttamente a Meta.</small></div>
            @if (Model.Existing?.InGroup == true || (Model.IsNew && Model.Input.OrganizationId is not null) || Model.IsNew)
            {
                <div class="field full" id="billToField" hidden="@(Model.Existing is not null && !Model.Existing.InGroup)"><label>Rendiconto intestato a</label>
                    <label class="check"><input type="radio" name="BillTo" value="gruppo" checked="@(Model.BillTo == "gruppo")"> Il gruppo (un solo rendiconto per tutte le sue attività)</label>
                    <label class="check"><input type="radio" name="BillTo" value="attivita" checked="@(Model.BillTo == "attivita")"> Questa attività, con i suoi dati fiscali (da «Dati e logo»)</label>
                    <label class="check"><input type="radio" name="BillTo" value="gestore" checked="@(Model.BillTo == "gestore")"> Un gestore con più attività del gruppo:
                        <select name="EntityId" style="width:auto;display:inline-block;margin-left:6px"><option value="">— scegli —</option>@foreach (var x in Model.Entities.Where(x => x.IsActive || x.Id == Model.EntityId)) { <option value="@x.Id" selected="@(x.Id == Model.EntityId)">@x.Name</option> }</select></label>
                    <small>I gestori si creano in Rendiconti → <a href="/Fatturazione/Gestori">Gestori</a>.@(Model.IsNew ? " Per una nuova attività i gestori del gruppo compaiono dopo il primo salvataggio." : "")</small>
                    <span asp-validation-for="EntityId" class="field-error"></span></div>
            }
            <div class="field"><label for="Fee">Canone mensile (€)</label><input id="Fee" name="Fee" value="@Model.Fee" inputmode="decimal" placeholder="vuoto = canone di base (@Model.DefaultFee.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("it-IT")) €)"><span asp-validation-for="Fee" class="field-error"></span></div>
            <div class="field"><label for="FeeFrom">Abbonamento attivo dal</label><input id="FeeFrom" name="FeeFrom" type="date" value="@Model.FeeFrom?.ToString("yyyy-MM-dd")"><small>Vuoto = abbonamento non ancora attivo: niente canone.</small></div>
            <div class="field"><label for="FeeTo">fino al (facoltativo)</label><input id="FeeTo" name="FeeTo" type="date" value="@Model.FeeTo?.ToString("yyyy-MM-dd")"><span asp-validation-for="FeeTo" class="field-error"></span></div>
        }
        <div class="field full"><label class="check"><input asp-for="Input.IsActive"> Attività attiva</label><small>Un'attività singola disattivata blocca anche l'accesso dei suoi utenti.</small></div>
    </div>
    <div class="actions"><a class="btn" href="/Gyms">Annulla</a><button class="btn primary" type="submit">Salva</button></div>
</form>
@if (Model.Me.IsSuperAdmin && Model.IsNew)
{
<script>
(function () { var o = document.getElementById('org'), f = document.getElementById('sectorField');
  function sync() { f.style.display = o.value ? 'none' : ''; } o.addEventListener('change', sync); sync(); })();
</script>
}
