@page
@model MvChat.Web.Pages.Gyms.IndexModel
@{ ViewData["Title"] = "Palestre"; }
@section Actions { <a class="btn primary" href="/Gyms/Edit">Nuova palestra</a> }
<p class="muted" style="margin:0">Ogni palestra avrà la sua area di lavoro, il suo numero WhatsApp (Passo 4) e le sue liste. Nessuna palestra vede i dati di un'altra.</p>
<section class="panel"><div class="tbl"><table>
    <thead><tr>@if (Model.Me.IsSuperAdmin) {<th>Catena</th>}<th>Palestra</th><th>Città</th><th>Telefono</th><th>Utenti</th><th>Stato</th><th></th></tr></thead>
    <tbody>
    @foreach (var g in Model.Items)
    {
        <tr>@if (Model.Me.IsSuperAdmin) {<td>@g.OrganizationName</td>}
            <td><b>@g.Name</b><div class="muted">@g.Address</div></td><td>@g.City</td><td>@g.Phone</td><td>@g.Users</td>
            <td>@(g.IsActive ? Html.Raw("<span class=\"chip good\">Attiva</span>") : Html.Raw("<span class=\"chip\">Disattivata</span>"))</td>
            <td><a class="btn sm" href="/Gyms/Edit/@g.Id">Modifica</a></td></tr>
    }
    @if (Model.Items.Count == 0) { <tr><td colspan="7" class="muted">Nessuna palestra ancora.</td></tr> }
    </tbody>
</table></div></section>
