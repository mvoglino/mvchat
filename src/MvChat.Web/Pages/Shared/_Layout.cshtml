@inject MvChat.Web.Infrastructure.AppConfigStore Config
@inject Repos Repos
@inject MvChat.Web.Ai.ConversationRepo Convs
@{
    var product = Config.Current.ProductName;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var scope = signedIn ? User.Scope() : null;
    Branding? brand = null;
    if (scope is not null && Config.Current.Installed)
    {
        try
        {
            brand = scope.GymId is int gymId ? await Repos.ActivityBrandingAsync(gymId)
                  : scope.OrganizationId is int orgId ? await Repos.BrandingAsync(orgId) : null;
        }
        catch { brand = null; }
    }
    var accent = brand?.PrimaryColor ?? "#F6931E";
    // Avviso nel menu: conversazioni che aspettano una persona (solo dentro mvchat, nessuna email).
    var waiting = 0;
    // I rendiconti dell'amministratore attività esistono solo per le attività singole (nei gruppi sono intestati al gruppo).
    var inGroup = true;
    if (scope?.IsManager == true && scope.OrganizationId is int mo && Config.Current.Installed)
    {
        try { inGroup = await Repos.IsGroupAsync(mo); } catch { inGroup = true; }
    }
    if (scope is not null && Config.Current.Installed)
    {
        try { waiting = (await Convs.BadgeAsync(scope)).Count; } catch { waiting = 0; }
    }
    var bare = ViewData["Bare"] as bool? == true;
    string Cur(string prefix) => (ViewContext.RouteData.Values["page"] as string ?? "").StartsWith(prefix) ? "page" : "false";
}
<!doctype html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(waiting > 0 ? $"({waiting}) " : "")@(ViewData["Title"] is string t ? t + " · " : "")@product</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
    <style>:root{--accent:@accent}</style>
</head>
<body>
@if (bare || !signedIn)
{
    <main class="bare">
        <div class="bare-card">
            <div class="brand"><span class="brand-mark">@product[..1].ToUpper()</span><b>@product</b></div>
            @RenderBody()
        </div>
    </main>
}
else
{
    <div class="app">
        <aside class="rail">
            <div class="brand">
                @if (!string.IsNullOrEmpty(brand?.LogoUrl))
                {
                    <img src="@brand.LogoUrl" alt="@brand.Name" class="brand-logo">
                }
                else
                {
                    <span class="brand-mark">@((brand?.Name ?? product)[..1].ToUpper())</span>
                }
                <div><b>@(brand?.Name ?? product)</b><small>@Roles.Label(scope!.Role)</small></div>
            </div>
            @{
                // Menù a gruppi: ogni gruppo raccoglie un argomento, con le voci nell'ordine in cui si usano.
                var page = ViewContext.RouteData.Values["page"] as string ?? "";
                bool On(string prefix, params string[] except) => page.StartsWith(prefix) && !except.Any(e => page.StartsWith(e));
                var canWork = scope.CanManageUsers; // MVitalia, amministratore di gruppo, amministratore attività
                var groups = new List<(string Title, string? Hint, List<(string Label, string Href, bool Active, bool Badge)> Items)>();
                // L'ordine dei gruppi segue il lavoro: si organizza, si prepara l'assistente, si lancia la campagna, si segue la reception, si guardano i risultati.
                if (canWork)
                {
                    var setup = new List<(string Label, string Href, bool Active, bool Badge)>();
                    if (scope.IsOrgAdmin) setup.Add(("Dati e logo del gruppo", "/Gruppo", On("/Gruppo"), false));
                    if (scope.IsManager) setup.Add(("Dati e logo dell'attività", "/Attivita", On("/Attivita"), false));
                    if (scope.CanManageGyms) setup.Add(("Attività", "/Gyms", On("/Gyms"), false));
                    setup.Add(("Utenti", "/Users", On("/Users"), false));
                    setup.Add(("WhatsApp: numero e template", "/WhatsApp", On("/WhatsApp"), false));
                    groups.Add(("Organizzazione", "attività, persone, WhatsApp", setup));
                    groups.Add(("Assistente AI", "cosa sa e come dialoga", new()
                    {
                        ("1 · Scheda per l'assistente", "/Sedi", On("/Sedi"), false),
                        ("2 · Offerte", "/Offerte", On("/Offerte"), false),
                        ("3 · Modelli di obiettivo", "/Modelli", On("/Modelli", "/Modelli/Anteprima"), false),
                        ("4 · Anteprima istruzioni", "/Modelli/Anteprima", On("/Modelli/Anteprima"), false),
                        ("5 · Prova l'assistente", "/Assistente/Prova", On("/Assistente/Prova"), false),
                        ("6 · Banco di prova", "/Assistente/Banco", On("/Assistente/Banco"), false),
                    }));
                    groups.Add(("Campagne", "dalla lista all'invio", new()
                    {
                        ("1 · Liste contatti", "/Lists", On("/Lists"), false),
                        ("2 · Campagne", "/Campagne", On("/Campagne"), false),
                        ("Lista STOP", "/OptOuts", On("/OptOuts"), false),
                    }));
                }
                var reception = new List<(string Label, string Href, bool Active, bool Badge)>
                {
                    ("Conversazioni", "/Conversazioni", On("/Conversazioni", "/Conversazioni/Archivio"), true),
                    ("Archivio dialoghi", "/Conversazioni/Archivio", On("/Conversazioni/Archivio"), false),
                };
                if (canWork) reception.Add(("Risposte rapide", "/RisposteRapide", On("/RisposteRapide"), false));
                groups.Add(("Reception", "le conversazioni con i clienti", reception));
                if (canWork)
                {
                    var results = new List<(string Label, string Href, bool Active, bool Badge)> { ("Report", "/Report", On("/Report"), false) };
                    if (scope.IsOrgAdmin || (scope.IsManager && !inGroup)) results.Add(("Rendiconti", "/Fatturazione", On("/Fatturazione"), false));
                    results.Add(("Richieste privacy dei clienti", "/Privacy", On("/Privacy"), false));
                    groups.Add(("Risultati e privacy", null, results));
                }
                if (scope.IsSuperAdmin)
                {
                    groups.Add(("MVitalia", "gestione del servizio", new()
                    {
                        ("Gruppi", "/Orgs", On("/Orgs"), false),
                        ("Impostazioni Meta", "/Impostazioni/WhatsApp", On("/Impostazioni/WhatsApp"), false),
                        ("Impostazioni AI", "/Impostazioni/AI", On("/Impostazioni/AI"), false),
                        ("Fatturazione", "/Fatturazione", On("/Fatturazione"), false),
                        ("Impostazioni fatturazione", "/Impostazioni/Fatturazione", On("/Impostazioni/Fatturazione"), false),
                        ("Conservazione dei dati", "/Impostazioni/Privacy", On("/Impostazioni/Privacy"), false),
                        ("Registro tecnico", "/Impostazioni/Registro", On("/Impostazioni/Registro"), false),
                    }));
                }
            }
            <nav class="nav" aria-label="Sezioni">
                <a href="/" aria-current="@(page == "/Index" ? "page" : "false")" class="nav-home">@(scope.IsSuperAdmin ? "Pannello" : "Panoramica")</a>
                @foreach (var (title, hint, items) in groups)
                {
                    var open = items.Any(i => i.Active) || (title == "Reception" && !canWork);
                    var hasBadge = items.Any(i => i.Badge) && waiting > 0;
                    <details class="nav-group" open="@open">
                        <summary><span>@title@if (hasBadge) {<span class="badge" aria-hidden="true">@waiting</span>}</span>@if (hint is not null) {<small>@hint</small>}</summary>
                        @foreach (var it in items)
                        {
                            <a href="@it.Href" aria-current="@(it.Active ? "page" : "false")">@it.Label@if (it.Badge) {<span class="badge" id="waitBadge" aria-label="conversazioni che aspettano una persona" hidden="@(waiting == 0)">@waiting</span>}</a>
                        }
                    </details>
                }
            </nav>
            <div class="rail-foot">
                <span>@scope.Name</span>
                <a href="/Account/Password">Cambia password</a>
                <form method="post" action="/Logout"><button type="submit" class="linklike">Esci</button></form>
                <small>@product · v@(typeof(Program).Assembly.GetName().Version?.ToString(3))</small>
            </div>
        </aside>
        <main class="main">
            <header class="top">
                <h1>@ViewData["Title"]</h1>
                @RenderSection("Actions", required: false)
            </header>
            @if (TempData["Ok"] is string ok)
            {
                <div class="flash ok" role="status">@ok</div>
            }
            @if (TempData["Err"] is string err)
            {
                <div class="flash err" role="alert">@err</div>
            }
            <div class="content">@RenderBody()</div>
        </main>
    </div>
}
@if (signedIn && !bare)
{
    <div class="toast" id="waitToast" role="status" aria-live="polite" hidden></div>
    <script>
    (function () {
        // Ogni 30 secondi controlla se ci sono conversazioni che aspettano una persona.
        var badge = document.getElementById('waitBadge'), toast = document.getElementById('waitToast');
        var last = @waiting, baseTitle = document.title.replace(/^\(\d+\) /, '');
        function show(s) {
            badge.textContent = s.count; badge.hidden = s.count === 0;
            document.title = (s.count > 0 ? '(' + s.count + ') ' : '') + baseTitle;
            if (s.count > last && s.id) {
                toast.innerHTML = '';
                var a = document.createElement('a'); a.href = '/Conversazioni/' + s.id;
                a.textContent = (s.name || 'Un cliente') + ' aspetta una risposta dalla reception';
                var x = document.createElement('button'); x.type = 'button'; x.textContent = '×'; x.setAttribute('aria-label', 'Chiudi');
                x.onclick = function () { toast.hidden = true; };
                toast.appendChild(a); toast.appendChild(x); toast.hidden = false;
            }
            last = s.count;
        }
        setInterval(function () {
            fetch('/Conversazioni?handler=Badge', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : null; }).then(function (s) { if (s) show(s); }).catch(function () { });
        }, 30000);
    })();
    </script>
}
</body>
</html>
