@inject MvChat.Web.Infrastructure.AppConfigStore Config
@inject Repos Repos
@inject MvChat.Web.Ai.ConversationRepo Convs
@{
    var product = Config.Current.ProductName;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var scope = signedIn ? User.Scope() : null;
    Branding? brand = null;
    if (scope is not null && Config.Current.Installed)
    {
        try
        {
            brand = scope.GymId is int gymId ? await Repos.ActivityBrandingAsync(gymId)
                  : scope.OrganizationId is int orgId ? await Repos.BrandingAsync(orgId) : null;
        }
        catch { brand = null; }
    }
    var accent = brand?.PrimaryColor ?? "#F6931E";
    // Avviso nel menu: conversazioni che aspettano una persona (solo dentro mvchat, nessuna email).
    var waiting = 0;
    // I rendiconti dell'amministratore attività esistono solo per le attività singole (nei gruppi sono intestati al gruppo).
    var inGroup = true;
    if (scope?.IsManager == true && scope.OrganizationId is int mo && Config.Current.Installed)
    {
        try { inGroup = await Repos.IsGroupAsync(mo); } catch { inGroup = true; }
    }
    if (scope is not null && Config.Current.Installed)
    {
        try { waiting = (await Convs.BadgeAsync(scope)).Count; } catch { waiting = 0; }
    }
    var bare = ViewData["Bare"] as bool? == true;
    string Cur(string prefix) => (ViewContext.RouteData.Values["page"] as string ?? "").StartsWith(prefix) ? "page" : "false";
}
<!doctype html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(waiting > 0 ? $"({waiting}) " : "")@(ViewData["Title"] is string t ? t + " · " : "")@product</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
    <style>:root{--accent:@accent}</style>
</head>
<body>
@if (bare || !signedIn)
{
    <main class="bare">
        <div class="bare-card">
            <div class="brand"><span class="brand-mark">@product[..1].ToUpper()</span><b>@product</b></div>
            @RenderBody()
        </div>
    </main>
}
else
{
    <div class="app">
        <aside class="rail">
            <div class="brand">
                @if (!string.IsNullOrEmpty(brand?.LogoUrl))
                {
                    <img src="@brand.LogoUrl" alt="@brand.Name" class="brand-logo">
                }
                else
                {
                    <span class="brand-mark">@((brand?.Name ?? product)[..1].ToUpper())</span>
                }
                <div><b>@(brand?.Name ?? product)</b><small>@Roles.Label(scope!.Role)</small></div>
            </div>
            <nav class="nav" aria-label="Sezioni">
                <a href="/" aria-current="@(Cur("/Index"))">@(scope.IsSuperAdmin ? "Pannello" : "Panoramica")</a>
                @if (scope.IsSuperAdmin)
                {
                    <a href="/Orgs" aria-current="@(Cur("/Orgs"))">Gruppi</a>
                    <a href="/Impostazioni/WhatsApp" aria-current="@(Cur("/Impostazioni/WhatsApp"))">Impostazioni Meta</a>
                    <a href="/Impostazioni/AI" aria-current="@(Cur("/Impostazioni/AI"))">Impostazioni AI</a>
                    <a href="/Fatturazione" aria-current="@(Cur("/Fatturazione"))">Fatturazione</a>
                    <a href="/Impostazioni/Privacy" aria-current="@(Cur("/Impostazioni/Privacy"))">Privacy e dati</a>
                    <a href="/Impostazioni/Registro" aria-current="@(Cur("/Impostazioni/Registro"))">Registro tecnico</a>
                }
                @if (scope.IsOrgAdmin || (scope.IsManager && !inGroup))
                {
                    <a href="/Fatturazione" aria-current="@(Cur("/Fatturazione"))">Rendiconti</a>
                }
                @if (scope.IsOrgAdmin)
                {
                    <a href="/Gruppo" aria-current="@(Cur("/Gruppo"))">Il gruppo</a>
                }
                @if (scope.CanManageGyms)
                {
                    <a href="/Gyms" aria-current="@(Cur("/Gyms"))">Attività</a>
                }
                @if (scope.IsManager)
                {
                    <a href="/Attivita" aria-current="@(Cur("/Attivita"))">La mia attività</a>
                }
                @if (scope.CanManageUsers)
                {
                    <a href="/Users" aria-current="@(Cur("/Users"))">Utenti</a>
                }
                @if (scope.CanManageUsers)
                {
                    <a href="/WhatsApp" aria-current="@(Cur("/WhatsApp"))">WhatsApp</a>
                    <a href="/Sedi" aria-current="@(Cur("/Sedi"))">Scheda per l'assistente</a>
                    <a href="/Offerte" aria-current="@(Cur("/Offerte"))">Offerte</a>
                    <a href="/Modelli" aria-current="@(Cur("/Modelli"))">Modelli di obiettivo</a>
                    <a href="/Assistente/Prova" aria-current="@(Cur("/Assistente"))">Prova l'assistente</a>
                    <a href="/Lists" aria-current="@(Cur("/Lists"))">Liste contatti</a>
                    <a href="/OptOuts" aria-current="@(Cur("/OptOuts"))">Lista STOP</a>
                    <a href="/Privacy" aria-current="@(Cur("/Privacy"))">Richieste privacy</a>
                }
                @if (scope.CanManageUsers)
                {
                    <a href="/Campagne" aria-current="@(Cur("/Campagne"))">Campagne</a>
                    <a href="/Report" aria-current="@(Cur("/Report"))">Report</a>
                }
                <a href="/Conversazioni" aria-current="@(Cur("/Conversazioni"))">Conversazioni <span class="badge" id="waitBadge" aria-label="conversazioni che aspettano una persona" hidden="@(waiting == 0)">@waiting</span></a>
            </nav>
            <div class="rail-foot">
                <span>@scope.Name</span>
                <a href="/Account/Password">Cambia password</a>
                <form method="post" action="/Logout"><button type="submit" class="linklike">Esci</button></form>
                <small>@product · v@(typeof(Program).Assembly.GetName().Version?.ToString(3))</small>
            </div>
        </aside>
        <main class="main">
            <header class="top">
                <h1>@ViewData["Title"]</h1>
                @RenderSection("Actions", required: false)
            </header>
            @if (TempData["Ok"] is string ok)
            {
                <div class="flash ok" role="status">@ok</div>
            }
            @if (TempData["Err"] is string err)
            {
                <div class="flash err" role="alert">@err</div>
            }
            <div class="content">@RenderBody()</div>
        </main>
    </div>
}
@if (signedIn && !bare)
{
    <div class="toast" id="waitToast" role="status" aria-live="polite" hidden></div>
    <script>
    (function () {
        // Ogni 30 secondi controlla se ci sono conversazioni che aspettano una persona.
        var badge = document.getElementById('waitBadge'), toast = document.getElementById('waitToast');
        var last = @waiting, baseTitle = document.title.replace(/^\(\d+\) /, '');
        function show(s) {
            badge.textContent = s.count; badge.hidden = s.count === 0;
            document.title = (s.count > 0 ? '(' + s.count + ') ' : '') + baseTitle;
            if (s.count > last && s.id) {
                toast.innerHTML = '';
                var a = document.createElement('a'); a.href = '/Conversazioni/' + s.id;
                a.textContent = (s.name || 'Un cliente') + ' aspetta una risposta dalla reception';
                var x = document.createElement('button'); x.type = 'button'; x.textContent = '×'; x.setAttribute('aria-label', 'Chiudi');
                x.onclick = function () { toast.hidden = true; };
                toast.appendChild(a); toast.appendChild(x); toast.hidden = false;
            }
            last = s.count;
        }
        setInterval(function () {
            fetch('/Conversazioni?handler=Badge', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : null; }).then(function (s) { if (s) show(s); }).catch(function () { });
        }, 30000);
    })();
    </script>
}
</body>
</html>
