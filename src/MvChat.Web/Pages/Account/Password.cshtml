@page
@model MvChat.Web.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Cambia password"; }
@if (Model.Forced)
{
    <div class="note warn">Stai usando una password provvisoria: scegline una tua per continuare.</div>
}
@if (Model.Error is not null)
{
    <div class="note warn" role="alert">@Model.Error</div>
}
<form method="post" class="panel">
    <div class="panel-b form">
        <div class="field full"><label asp-for="Current">Password attuale</label><input asp-for="Current" type="password" autocomplete="current-password"></div>
        <div class="field"><label asp-for="New">Nuova password</label><input asp-for="New" type="password" autocomplete="new-password"><small>Almeno 10 caratteri, con lettere e numeri.</small></div>
        <div class="field"><label asp-for="New2">Ripeti la nuova password</label><input asp-for="New2" type="password" autocomplete="new-password"></div>
    </div>
    <div class="actions"><button class="btn primary" type="submit">Salva</button></div>
</form>
