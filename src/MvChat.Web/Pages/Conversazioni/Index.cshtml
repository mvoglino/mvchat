@page
@model MvChat.Web.Pages.Conversazioni.IndexModel
@{ ViewData["Title"] = "Conversazioni"; var many = Model.Gyms.Count > 1; }
@section Actions { <a class="btn" href="/Conversazioni/Archivio">Archivio dialoghi</a>@if (Model.Me.CanManageUsers) { <a class="btn" href="/RisposteRapide">Risposte rapide</a> } }
<div class="stats">
    <a class="stat @(Model.Waiting > 0 ? "ko" : "")" href="?view=da_gestire&gym=@Model.Gym"><b>@Model.Waiting</b><span>aspettano una persona</span></a>
    <a class="stat" href="?view=ai&gym=@Model.Gym"><b>@Model.Counts.GetValueOrDefault("ai")</b><span>seguite dall'assistente</span></a>
    <a class="stat" href="?view=chiuse&gym=@Model.Gym"><b>@Model.Counts.GetValueOrDefault("chiusa")</b><span>chiuse</span></a>
</div>
<nav class="tabs" aria-label="Viste">
    @foreach (var (key, label) in IndexModel.Views)
    {
        <a href="?view=@key&gym=@Model.Gym" aria-current="@(key == Model.View ? "page" : "false")">@label</a>
    }
</nav>
@if (many)
{
    <form method="get" class="inline-form"><input type="hidden" name="view" value="@Model.View"><div class="field" style="max-width:300px"><label for="gym">Attività</label><select id="gym" name="gym" onchange="this.form.submit()"><option value="">Tutte</option>@foreach (var g in Model.Gyms) { <option value="@g.Id" selected="@(g.Id == Model.Gym)">@g.Name</option> }</select></div></form>
}
<section class="panel"><div class="tbl"><table>
    <thead><tr><th>Cliente</th>@if (many) {<th>Attività</th>}<th>Obiettivo</th><th>Stato</th><th>In carico a</th><th>Esito</th><th>Ultimo messaggio</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Items)
    {
        var waiting = c.Status == "operatore" && c.Awaiting;
        <tr>
            <td><b>@c.ContactName</b>@if (c.IsTest) {<span class="chip" style="margin-left:6px">prova</span>}<div class="muted">@c.ContactPhone</div></td>
            @if (many) {<td>@c.GymName</td>}
            <td>@c.GoalName</td>
            <td>@if (waiting) {<span class="chip warn">Il cliente aspetta @IndexModel.Waited(c.LastInboundAt)</span>} else if (c.Status == "operatore") {<span class="chip">Con la reception</span>} else if (c.Status == "ai") {<span class="muted">Risponde l'assistente</span>} else {<span class="muted">Chiusa</span>}</td>
            <td>@(c.AssignedName ?? (c.Status == "operatore" ? "— libera —" : ""))</td>
            <td><span class="chip @Outcomes.Css(c.Outcome)">@Outcomes.Label(c.Outcome)</span></td>
            <td class="muted">@(c.LastMessageAt?.ToRome().ToString("dd/MM HH:mm") ?? "—")</td>
            <td><a class="btn sm" href="/Conversazioni/@c.Id">Apri</a></td>
        </tr>
    }
    @if (Model.Items.Count == 0) { <tr><td colspan="8" class="muted">@(Model.View == "da_gestire" ? "Nessuna conversazione aspetta una persona. Ottimo lavoro!" : "Nessuna conversazione in questa vista.")</td></tr> }
    </tbody>
</table></div></section>
