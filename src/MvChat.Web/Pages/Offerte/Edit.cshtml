@page "{id:int?}"
@model MvChat.Web.Pages.Offerte.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Nuova offerta" : "Modifica offerta"; }
@if (Model.Gyms.Count == 0)
{
    <div class="note warn">Non ci sono attività attive.</div>
}
else
{
<form method="post" class="panel">
    <input type="hidden" asp-for="Input.Id">
    <div class="panel-b form">
        @if (Model.IsNew && Model.Gyms.Count > 1)
        {
            <div class="field full"><label asp-for="Input.GymId">Attività</label>
                <select asp-for="Input.GymId" asp-items="@(new SelectList(Model.Gyms, "Id", "Name"))"></select><span asp-validation-for="Input.GymId" class="field-error"></span></div>
        }
        else
        {
            <input type="hidden" asp-for="Input.GymId">
            <div class="field full"><label>Attività</label><div>@(Model.Gyms.FirstOrDefault(g => g.Id == Model.Input.GymId)?.Name)</div><span asp-validation-for="Input.GymId" class="field-error"></span></div>
        }
        <div class="field full"><label asp-for="Input.Title">Titolo</label><input asp-for="Input.Title" placeholder="es. Rinnovo annuale con 2 mesi omaggio"><span asp-validation-for="Input.Title" class="field-error"></span></div>
        <div class="field full"><label asp-for="Input.Description">Cosa comprende</label><textarea asp-for="Input.Description" rows="3" placeholder="es. 14 mesi di accesso illimitato a sala e corsi al prezzo di 12"></textarea><span asp-validation-for="Input.Description" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.Price">Prezzo dell'offerta (€)</label><input asp-for="Input.Price" inputmode="decimal" placeholder="es. 399"><span asp-validation-for="Input.Price" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.FullPrice">Prezzo pieno (€, facoltativo)</label><input asp-for="Input.FullPrice" inputmode="decimal" placeholder="es. 465"><small>Se lo indichi, l'assistente può dire «invece di».</small><span asp-validation-for="Input.FullPrice" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.PriceNote">Nota sul prezzo</label><input asp-for="Input.PriceNote" placeholder="es. una tantum · al mese · iscrizione inclusa"></div>
        <div class="field"><label asp-for="Input.MaxExtraDiscountPct">Sconto extra che l'assistente può concedere</label>
            <select asp-for="Input.MaxExtraDiscountPct"><option value="0">Nessuno</option><option value="5">Fino al 5%</option><option value="10">Fino al 10%</option><option value="15">Fino al 15%</option><option value="20">Fino al 20%</option></select>
            <small>Solo se il cliente esita sul prezzo, mai proposto subito.</small><span asp-validation-for="Input.MaxExtraDiscountPct" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.ValidFrom">Valida dal</label><input asp-for="Input.ValidFrom" type="date"></div>
        <div class="field"><label asp-for="Input.ValidTo">Valida fino al (compreso)</label><input asp-for="Input.ValidTo" type="date"><span asp-validation-for="Input.ValidTo" class="field-error"></span></div>
        <div class="field full"><label asp-for="Input.Conditions">Condizioni</label><textarea asp-for="Input.Conditions" rows="2" placeholder="es. valida solo per chi rinnova prima della scadenza; non cumulabile"></textarea></div>
        <div class="field full"><label asp-for="Input.ActionUrl">Link per aderire (facoltativo)</label><input asp-for="Input.ActionUrl" placeholder="https://..."><small>Se manca, l'assistente invita a passare in reception.</small><span asp-validation-for="Input.ActionUrl" class="field-error"></span></div>
        <div class="field full"><label class="check"><input asp-for="Input.IsActive"> Offerta attiva</label></div>
    </div>
    <div class="actions"><a class="btn" href="/Offerte">Annulla</a><button class="btn primary" type="submit">Salva</button></div>
</form>
}
